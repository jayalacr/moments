# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Resend (emails transaccionales)
RESEND_API_KEY=re_tu_api_key
RESEND_FROM_EMAIL=Moments <hola@tudominio.com>

# Admin
SUPERADMIN_EMAIL=admin@tudominio.com

# Seguridad para cron jobs
CRON_SECRET=genera-con-openssl-rand-hex-32

# URL base de la aplicación
NEXT_PUBLIC_BASE_URL=https://tudominio.com

# Dominio raíz para subdominios de clientes (ej. juan-y-maria.tudominio.com)
NEXT_PUBLIC_ROOT_DOMAIN=tudominio.com

# Número de WhatsApp de ventas (formato internacional sin +, ej. 528126390927)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Meta Pixel (opcional — sin esto, el Pixel simplemente no se monta)
NEXT_PUBLIC_META_PIXEL_ID=

# Cloudinary (imágenes)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tu-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=tu-upload-preset

# ISR - Revalidación bajo demanda
REVALIDATION_SECRET=genera-con-openssl-rand-hex-32
